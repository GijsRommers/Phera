--TEST--
Serialization preserves PHP's layout behavior
--FILE--
<?php
class CacheParent { private $id = 4; protected $tag = 'route'; }
class CacheChild extends CacheParent { private $id = 'v2'; public $weight = 3.0625; }
$value = new CacheChild;
$wire = serialize($value);
echo bin2hex($wire), "\n";
var_dump(serialize(unserialize($wire)) === $wire);
$values = [$value, $value];
$wire = serialize($values);
echo bin2hex($wire), "\n";
$result = unserialize($wire);
var_dump($result[0] === $result[1]);
$value->weight = ['nested' => -0.0];
$wire = serialize($value);
echo bin2hex($wire), "\n";
var_dump(serialize(unserialize($wire)) === $wire);
--EXPECT--
