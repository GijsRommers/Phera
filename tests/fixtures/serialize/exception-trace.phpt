--TEST--
An exception trace and previous exception survive an exact round trip
--FILE--
<?php
$bytes = hex2bin(
    '4f3a31343a224572726f72457863657074696f6e223a383a7b733a31303a22002a006d657373616765223b733a31' .
    '303a224a6f62206661696c6564223b733a31373a2200457863657074696f6e00737472696e67223b733a303a2222' .
    '3b733a373a22002a00636f6465223b693a313b733a373a22002a0066696c65223b733a31323a222f7372762f4a6f' .
    '622e706870223b733a373a22002a006c696e65223b693a39353b733a31363a2200457863657074696f6e00747261' .
    '6365223b613a313a7b693a303b613a343a7b733a343a2266696c65223b733a31353a222f7372762f52756e6e6572' .
    '2e706870223b733a343a226c696e65223b693a31303b733a383a2266756e6374696f6e223b733a373a226661696c' .
    '4a6f62223b733a343a2261726773223b613a313a7b693a303b733a31333a227765656b6c792d7265706f7274223b' .
    '7d7d7d733a31393a2200457863657074696f6e0070726576696f7573223b4f3a31343a224572726f724578636570' .
    '74696f6e223a383a7b733a31303a22002a006d657373616765223b733a31333a224150492074696d6564206f7574' .
    '223b733a31373a2200457863657074696f6e00737472696e67223b733a303a22223b733a373a22002a00636f6465' .
    '223b693a3530333b733a373a22002a0066696c65223b733a31323a222f7372762f4170692e706870223b733a373a' .
    '22002a006c696e65223b693a34353b733a31363a2200457863657074696f6e007472616365223b613a313a7b693a' .
    '303b613a343a7b733a343a2266696c65223b733a31353a222f7372762f52756e6e65722e706870223b733a343a22' .
    '6c696e65223b693a31303b733a383a2266756e6374696f6e223b733a373a226661696c4a6f62223b733a343a2261' .
    '726773223b613a313a7b693a303b733a31333a227765656b6c792d7265706f7274223b7d7d7d733a31393a220045' .
    '7863657074696f6e0070726576696f7573223b4e3b733a31313a22002a007365766572697479223b693a3531323b' .
    '7d733a31313a22002a007365766572697479223b693a3235363b7d'
);
$exception = unserialize($bytes);
var_dump($exception->getMessage(), $exception->getFile(), $exception->getLine(), $exception->getTrace());
$previous = $exception->getPrevious();
var_dump($previous->getMessage(), $previous->getCode(), $previous->getTrace());
var_dump(serialize($exception) === $bytes);
?>
--EXPECT--
string(10) "Job failed"
string(12) "/srv/Job.php"
int(95)
array(1) {
  [0]=>
  array(4) {
    ["file"]=>
    string(15) "/srv/Runner.php"
    ["line"]=>
    int(10)
    ["function"]=>
    string(7) "failJob"
    ["args"]=>
    array(1) {
      [0]=>
      string(13) "weekly-report"
    }
  }
}
string(13) "API timed out"
int(503)
array(1) {
  [0]=>
  array(4) {
    ["file"]=>
    string(15) "/srv/Runner.php"
    ["line"]=>
    int(10)
    ["function"]=>
    string(7) "failJob"
    ["args"]=>
    array(1) {
      [0]=>
      string(13) "weekly-report"
    }
  }
}
bool(true)
