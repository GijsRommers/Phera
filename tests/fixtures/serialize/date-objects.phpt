--TEST--
Native date classes round-trip through their PHP methods
--FILE--
<?php
$zone = new DateTimeZone('Europe/Brussels');
$date = new DateTimeImmutable('2026-11-18 06:07:08.123456', $zone);
$objects = [$zone, $date, DateTime::createFromImmutable($date), new DateInterval('P2DT3H'),
    new DatePeriod($date, new DateInterval('P1D'), 2)];
foreach ($objects as $object) {
    $blob = serialize($object);
    echo bin2hex($blob), "\n";
    var_dump(serialize(unserialize($blob)) === $blob);
}
?>
