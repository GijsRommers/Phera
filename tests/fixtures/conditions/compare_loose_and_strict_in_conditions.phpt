--TEST--
compare_loose_and_strict_in_conditions
--FILE--
<?php
$values = [0, 1, -1, 0.0, -0.0, 1.5, NAN, true, false, null, "", "0", "1", "1.5", "abc", "0abc", "1e2", " 1", [], [0], [1], ["a"=>1]];
foreach ($values as $i => $a) {
  foreach ($values as $j => $b) {
    $r = '';
    if ($a == $b) { $r .= '1'; } else { $r .= '0'; }
    if ($a != $b) { $r .= '1'; } else { $r .= '0'; }
    if ($a === $b) { $r .= '1'; } else { $r .= '0'; }
    if ($a !== $b) { $r .= '1'; } else { $r .= '0'; }
    if ($a < $b) { $r .= '1'; } else { $r .= '0'; }
    if ($a <= $b) { $r .= '1'; } else { $r .= '0'; }
    if ($a > $b) { $r .= '1'; } else { $r .= '0'; }
    if ($a >= $b) { $r .= '1'; } else { $r .= '0'; }
    echo $i, ' ', $j, ' ', $r, "\n";
  }
}
